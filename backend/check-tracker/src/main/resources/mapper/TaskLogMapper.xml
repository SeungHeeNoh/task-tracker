<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hohohehe.tasktracker.mapper.TaskLogMapper">
    <insert id="addTaskLog" parameterType="com.hohohehe.tasktracker.model.entity.TaskLog">
        INSERT INTO task_log
        (
         task_id,
         task_status,
         created_at,
         created_by
        )
        VALUE
        (
         #{taskId},
         #{taskStatus},
         NOW(),
         #{createdBy}
        )
    </insert>
</mapper>