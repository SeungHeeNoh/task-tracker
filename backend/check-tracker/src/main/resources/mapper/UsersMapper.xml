<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hohohehe.tasktracker.mapper.UsersMapper">
    <select id="findByUserId" parameterType="string" resultType="com.hohohehe.tasktracker.model.entity.Users">
        SELECT user_seq,
               user_id,
               user_name,
               password,
               avatar_img,
               created_at,
               created_by,
               modified_at,
               modified_by
        FROM users
        WHERE user_id = #{userId}
    </select>
</mapper>